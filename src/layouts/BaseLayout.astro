---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}

const {
  title,
  description,
  ogTitle = "Una vida con opciones se construye antes de necesitarlas.",
  ogDescription = "Capacidad, margen y dirección para recuperar libertad real de decisión.",
  ogImage = "/og-home.png",
} = Astro.props;

const fullTitle = `${title} — Gonzalo Pareja`;
const absoluteOgImage = new URL(ogImage, "https://gonzalopareja.com").toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Gonzalo Pareja" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content="Gonzalo Pareja — Capacidad, margen y dirección" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={absoluteOgImage} />
  </head>
  <body>
    <slot />
  </body>
</html>
