---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  noindex?: boolean;
  enableAnalytics?: boolean;
}

const {
  title,
  description,
  ogTitle = "Deja de depender de un salario — Programa de Intervención 60D",
  ogDescription = "Acompañamiento privado 1:1 para aumentar ingresos, recuperar margen y construir libertad real.",
  ogImage = "/og-social-programa-intervencion.png",
  noindex = false,
  enableAnalytics = true,
} = Astro.props;

const fullTitle = `${title} — Gonzalo Pareja`;
const absoluteOgImage = new URL(ogImage, "https://gonzalopareja.com").toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0b0b0b" />
    <title>{fullTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Gonzalo Pareja" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gonzalo Pareja — Tu vida. Tus decisiones. Sin depender de un sueldo." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={absoluteOgImage} />

    {
      enableAnalytics && (
        <script is:inline>
          (function (c, l, a, r, i, t, y) {
            c[a] =
              c[a] ||
              function () {
                (c[a].q = c[a].q || []).push(arguments);
              };
            t = l.createElement(r);
            t.async = 1;
            t.src = "https://www.clarity.ms/tag/" + i;
            y = l.getElementsByTagName(r)[0];
            y.parentNode.insertBefore(t, y);
          })(window, document, "clarity", "script", "vs4dl71i34");
        </script>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
