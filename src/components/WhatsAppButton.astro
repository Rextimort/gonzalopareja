---
interface Props {
  label?: string;
  message?: string;
}

const defaultMessage = "Hola Gonzalo. He visto tu web y quiero saber si la Intervención 60D encaja con mi situación.";
const { label = "Contarte mi situación", message = defaultMessage } = Astro.props;
const whatsapp = `https://wa.me/34690205133?text=${encodeURIComponent(message)}`;
---

<a class="button button-primary" href={whatsapp} target="_blank" rel="noreferrer">
  <span>{label}</span>
  <span aria-hidden="true">↗</span>
</a>
