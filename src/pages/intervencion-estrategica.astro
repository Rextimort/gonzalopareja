---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import VideoFrame from "../components/VideoFrame.astro";

const workAreas = [
  { n: "01", title: "Radiografía real", text: "Qué estás sosteniendo, qué te está frenando y cuánto cuesta seguir exactamente igual." },
  { n: "02", title: "Capacidad y margen", text: "Reducimos presión y recuperamos espacio para que puedas decidir sin ponerlo todo en riesgo." },
  { n: "03", title: "Ingresos y dirección", text: "Reposicionamiento, nuevas capacidades y decisiones alineadas con tu potencial real." },
  { n: "04", title: "Estructura de vida", text: "Rediseñamos lo que mantienes para construir más libertad, estabilidad y opciones." },
];

const included = [
  ["90–120 min", "Diagnóstico inicial", "Una radiografía completa de tu situación y del coste real de seguir igual."],
  ["Ruta definida", "Plan de intervención", "Decisiones ordenadas, prioridades, responsables y plazos concretos."],
  ["Semanal", "Revisión 1:1", "Seguimiento, desbloqueo y ajuste del plan sobre lo que sucede en tu vida."],
  ["Directo", "Canal privado", "Contacto conmigo para decisiones clave y minicalls cuando haga falta."],
];

const transformationStages = [
  { n: "01", title: "Recuperar margen", text: "Eliminar fricción, revisar costes, ordenar decisiones y recuperar capacidad real de movimiento." },
  { n: "02", title: "Elevar ingresos", text: "Optimizar la posición profesional actual o construir una habilidad que permita acceder a un nivel de ingresos superior." },
  { n: "03", title: "Convertir ingresos en libertad", text: "Evitar que el aumento de ingresos se convierta en más dependencia. Reestructurar el margen y automatizar decisiones." },
  { n: "04", title: "Construir los primeros activos", text: "Empezar a transformar ahorro estable en activos o fuentes de ingresos que no dependan del trabajo diario." },
  { n: "05", title: "Diseñar la independencia", text: "Definir el plan, las reglas y la estructura de largo plazo que permitirán reducir progresivamente la dependencia del salario." },
];

const programFormats = [
  {
    n: "01",
    duration: "60 días",
    title: "Intervención 60D",
    price: "2.400 €",
    summary: "Para personas con una base sólida que necesitan recuperar margen, ordenar decisiones o ejecutar un movimiento principal claramente definido.",
    detail: "La intervención concentra desde el primer día diagnóstico, dirección y ejecución.",
    phases: ["Intervención intensiva · 60 días"],
    included: [
      "Diagnóstico y definición de la ruta.",
      "Plan de intervención.",
      "Revisión semanal.",
      "Canal privado entre revisiones.",
      "Minicalls cuando una decisión necesita resolverse con rapidez.",
    ],
  },
  {
    n: "02",
    duration: "90 días",
    title: "Intervención 90D",
    price: "3.200 €",
    summary: "Cuando el proceso exige una transición más profunda, negociación, reposicionamiento profesional o ejecución sostenida durante tres meses.",
    detail: "Incluye todo lo anterior y un periodo adicional de intervención intensiva.",
    phases: ["Intervención intensiva · 90 días"],
  },
  {
    n: "03",
    duration: "6 meses",
    title: "Recorrido 6 meses",
    price: "5.000 €",
    summary: "Para procesos en los que hay que construir una nueva capacidad, elevar ingresos, reposicionarse y estabilizar la nueva estructura.",
    detail: "Los primeros 90 días concentran el trabajo de intervención. Los tres meses posteriores se dedican a consolidación, seguimiento, corrección de desviaciones y decisiones puntuales.",
    phases: ["90 días · Intervención", "3 meses · Consolidación"],
  },
  {
    n: "04",
    duration: "12 meses",
    title: "Recorrido 12 meses",
    price: "6.800 €",
    summary: "Para personas que parten de una estructura más frágil o necesitan construir y consolidar una transformación completa a lo largo del tiempo.",
    detail: "Los primeros 90 días concentran la intervención. Los nueve meses siguientes aportan dirección, seguimiento y continuidad durante la ejecución.",
    phases: ["90 días · Intervención", "9 meses · Continuidad"],
  },
];

const faqs = [
  ["¿Tengo que dejar mi trabajo?", "No. El objetivo no es escapar del empleo, sino dejar de necesitar que sea tu única opción. En algunos casos la decisión correcta es reposicionarte y ganar más; en otros, reducir estructura o crear una vía adicional."],
  ["¿Se consigue la libertad en 60 días?", "No prometo una vida resuelta en 60 días. 60D identifica el formato base y el origen del método, no la duración obligatoria de todos los procesos. Según el punto de partida, la ruta recomendada puede ser de 60 días, 90 días, 6 meses o 12 meses."],
  ["¿Voy a tener que cambiar radicalmente mi vida?", "No necesariamente. Muchas veces no se trata de destruir lo construido, sino de dejar de sostener partes que ya no eliges conscientemente. El proceso es estratégico y gradual."],
  ["¿Y si mi situación es demasiado particular?", "Por eso la intervención es personalizada. No trabajamos con una fórmula genérica: partimos de tu estructura, tus miedos, tus obligaciones y el margen que tienes hoy."],
  ["¿Es terapia o asesoría financiera?", "No es terapia ni una recomendación de inversión aislada. Es una intervención estratégica sobre ingresos, gastos, decisiones, identidad y estructura de vida. Cuando un asunto exige un profesional regulado, se deriva."],
  ["¿Me garantizas resultados?", "No. Y desconfía de quien lo haga. Lo que sí garantizo es criterio, dirección y un proceso para tomar decisiones y ejecutarlas: recuperar margen, aumentar tus ingresos si ese es tu caso, construir reglas de decisión para no dar pasos atrás y planificar tus primeras inversiones. El recorrido dependerá de los objetivos que fijemos y del tiempo contratado. El resultado depende también de que hagas lo que toca."],
];
---

<BaseLayout
  title="Intervención Estratégica 60D"
  description="Programa de Intervención 60D: acompañamiento privado 1:1 con recorridos de 60 días a 12 meses para construir margen, elevar ingresos y reducir dependencia salarial."
>
  <main class="intervencion-page">
    <Header active="intervencion" />

    <section class="hero intervention-hero">
      <div class="hero-glow copper-glow" aria-hidden="true"></div>
      <div class="shell intervention-intro">
        <span class="eyebrow copper">Programa de Intervención 60D · Acompañamiento privado 1:1</span>
        <h1>Tu salario no es el problema.<br /><em>Que tu vida dependa de él, sí.</em></h1>
        <p class="hero-lead narrow">
          <span class="intervention-lead-desktop">Una intervención 1:1 para construir nuevas vías de ingresos, recuperar margen y alcanzar una libertad real: que tu vida responda a tus decisiones, no a una única fuente de estabilidad.</span>
          <span class="intervention-lead-mobile">Una intervención 1:1 para construir nuevas vías de ingresos, recuperar margen y alcanzar una libertad real: que tu vida responda a tus decisiones.</span>
        </p>
        <div class="hero-actions centered">
          <WhatsAppButton />
          <span class="cta-note">Te hago dos preguntas. Si no encaja, te lo diré.</span>
        </div>
      </div>
      <div class="shell vsl-wrap">
        <VideoFrame
          eyebrow="La intervención, explicada por Gonzalo"
          title="Qué es la Intervención Estratégica 60D"
          src="https://www.loom.com/embed/4a023603841845c597abf82503b0e363?hide_owner=true&hide_share=true&hide_title=true&hideEmbedTopBar=true"
        />
        <div class="vsl-action">
          <span class="vsl-action-index" aria-hidden="true">GP</span>
          <div class="vsl-action-copy">
            <span>Después de ver el vídeo</span>
            <p>Si quieres que valore si la Intervención encaja contigo, cuéntame tu situación.</p>
            <small>Abre WhatsApp · Te hago dos preguntas · Respondo yo personalmente</small>
          </div>
          <WhatsAppButton label="Quiero entrar al programa" />
        </div>
      </div>
    </section>

    <section class="section promise-strip">
      <div class="shell promise-grid">
        <p>Esto no es un curso.</p>
        <p>No es motivación.</p>
        <p>No es una fórmula para “escalar”.</p>
        <strong>Es una intervención sobre tu vida real.</strong>
      </div>
    </section>

    <section class="section advisory-section" id="metodo">
      <div class="shell advisory-card">
        <figure class="advisory-photo">
          <img src="/intervencion-private-advisory.jpg" alt="Gonzalo Pareja trabajando en una conversación estratégica individual" />
          <figcaption>
            <span>Intervención real</span>
            Conversación, criterio y decisiones 1:1
          </figcaption>
        </figure>

        <div class="advisory-copy">
          <div class="advisory-copy-intro">
            <span class="eyebrow copper">Programa de Intervención 60D · Método privado</span>
            <h2>Intervención directa.<br /><em>Trabajo 1:1. Decisiones reales.</em></h2>
            <p class="advisory-lead">Una primera fase intensiva sobre tu situación real: sin teoría innecesaria ni motivación vacía. Analizamos tus ingresos, gastos, obligaciones y decisiones para construir una ruta viable y ejecutarla contigo.</p>
          </div>

          <div class="advisory-areas">
            {workAreas.map((area) => (
              <article>
                <span>{area.n}</span>
                <h3>{area.title}</h3>
                <p>{area.text}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="advisory-format" aria-label="Formato de la intervención">
          {included.map(([meta, title, text]) => (
            <div>
              <span>{meta}</span>
              <strong>{title}</strong>
              <p>{text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section origin-section" id="historia">
      <div class="shell origin-intro">
        <div>
          <span class="eyebrow copper">Un método construido desde la experiencia</span>
          <h2>“Mi vida funcionaba… mientras todo siguiera funcionando igual.”</h2>
        </div>
        <p class="origin-lead">En 2018, durante una comida con otros directivos, una decisión tomada por «los de arriba» me hizo ver que la vida que había construido podía dejar de depender de mí.</p>
      </div>

      <div class="shell origin-composition">
        <figure class="origin-photo-stage">
          <img src="/intervencion-arms.jpg" alt="Gonzalo Pareja apoyado sobre los bloques que cuentan su historia" />
        </figure>

        <div class="origin-story-panel" id="historia-bloques">
          <article>
            <span>Lo que parecía</span>
            <h3>Una vida resuelta.</h3>
            <p>Ganaba más de 3.500 € al mes. Tenía <em>estatus</em>, coche y un piso en propiedad. Desde fuera, todo funcionaba.</p>
          </article>
          <article>
            <span>Lo que realmente había</span>
            <h3>Todo dependía de mi salario.</h3>
            <p>Entendí que no tenía capacidad real de decidir. Vacié mi casa, alquilé dormitorios y reduje conscientemente mi nivel de vida para construir margen antes de necesitarlo.</p>
          </article>
          <blockquote>“La libertad no se construye con lo que puedes permitirte, sino con lo que eres capaz de sostener sin depender.”</blockquote>
        </div>
      </div>
    </section>

    <section class="section case-section light-section" id="casos-reales">
      <div class="shell section-heading centered-heading">
        <span class="eyebrow dark">Dos puntos de entrada. Una misma dirección.</span>
        <h2 class="display-dark">No todos necesitan empezar por lo mismo.</h2>
        <p>El primer vídeo recorre un caso real de Nivel 1. El segundo explica el trabajo de Nivel 2 para quien ya gana bien, pero sigue dependiendo de una sola estructura.</p>
      </div>
      <div class="shell case-video-grid">
        <div>
          <VideoFrame
            eyebrow="Punto de entrada · Nivel 1"
            title="Un caso real: cuando faltan capacidad y dirección"
            src="https://www.loom.com/embed/7e031a268cad4e969e2ce57c1c3de375?hide_owner=true&hide_share=true&hide_title=true&hideEmbedTopBar=true&autoplay=1"
            poster="/case-level-1-poster.jpg"
            posterLabel="Extracto del podcast"
            placeholder
          />
          <div class="case-caption">
            <strong>Construir capacidad</strong>
            <p>Un caso real sobre cómo desarrollar una capacidad monetizable y convertirla en dirección e ingresos.</p>
          </div>
        </div>
        <div>
          <VideoFrame
            eyebrow="Punto de entrada · Nivel 2"
            title="Recuperar libertad cuando ganas bien, pero sigues atrapado"
            src="https://www.loom.com/embed/027f62c2c09442b89a67a6ab04469462?hide_owner=true&hide_share=true&hide_title=true&hideEmbedTopBar=true&autoplay=1"
            poster="/case-level-2-poster.jpg"
            posterLabel="Extracto del podcast"
            placeholder
          />
          <div class="case-caption">
            <strong>Recuperar libertad</strong>
            <p>Una explicación del recorrido para quien gana bien, pero necesita margen, estructura y más de una opción.</p>
          </div>
        </div>
      </div>
      <div class="shell proof-grid">
        <article>
          <small>Resultados de clientes</small>
          <div>
            <strong>+30–60 %</strong>
            <span>Incremento del salario anual conseguido por varios clientes en un solo año.</span>
          </div>
        </article>
        <article>
          <small>Tiempo promedio</small>
          <div>
            <strong>18 meses</strong>
            <span>Tiempo promedio observado para pasar desde cero hasta la independencia financiera.</span>
          </div>
        </article>
        <article>
          <small>Casos reales</small>
          <div>
            <strong>1.200 € → 5.000 €+</strong>
            <span>De un salario de 1.200 € al mes a una facturación propia superior a 5.000 € mensuales en un año.</span>
          </div>
        </article>
      </div>
    </section>

    <section class="section program-route-section" id="inversion">
      <span class="program-route-watermark" aria-hidden="true">RUTA</span>

      <div class="shell program-route-intro">
        <div>
          <span class="eyebrow copper">Una ruta, no un programa genérico</span>
          <h2>El tiempo necesario depende de dónde empiezas.</h2>
        </div>
        <div class="program-route-copy">
          <p>La intervención no aplica una fórmula idéntica a todas las personas. Primero analizamos tu estructura, identificamos el movimiento que puede cambiarla y definimos el recorrido necesario para ejecutarlo.</p>
          <p>En algunos casos, 60 días son suficientes para recuperar margen y tomar una decisión crítica. En otros, es necesario construir ingresos, desarrollar una nueva capacidad, consolidar los cambios o preparar las primeras inversiones.</p>
          <p>Antes de empezar sabrás con claridad qué recorrido recomiendo, por qué y cuál será la inversión total.</p>
        </div>
      </div>

      <div class="shell program-brand-note">
        <strong>60D</strong>
        <p><b>60D identifica el formato base y el origen del método,</b> no la duración obligatoria de todos los procesos. La ruta completa se define tras el Diagnóstico 1:1.</p>
      </div>

      <div class="shell transformation-route" aria-label="Posibles etapas del recorrido de transformación">
        {transformationStages.map((stage) => (
          <article>
            <span>{stage.n}</span>
            <h3>{stage.title}</h3>
            <p>{stage.text}</p>
          </article>
        ))}
      </div>

      <p class="shell transformation-note">No todos los procesos comienzan en el mismo punto ni necesitan recorrer todas las etapas. El Diagnóstico 1:1 determina la ruta.</p>

      <div class="shell program-formats-heading">
        <span class="eyebrow copper">Formatos del Programa</span>
        <h3>Una intensidad al principio.<br /><em>Una continuidad cuando hace falta.</em></h3>
        <p>El formato recomendado se determina únicamente después del Diagnóstico 1:1. Cada importe corresponde a la inversión total del recorrido.</p>
      </div>

      <div class="shell program-formats">
        {programFormats.map((format) => (
          <article class="program-format">
            <span class="program-format-index" aria-hidden="true">{format.n}</span>
            <header class="program-format-name">
              <span>{format.duration}</span>
              <h4>{format.title}</h4>
            </header>
            <div class="program-format-content">
              <p>{format.summary}</p>
              <p class="program-format-detail">{format.detail}</p>
              <div class="program-format-phases" aria-label="Fases del recorrido">
                {format.phases.map((phase) => <span>{phase}</span>)}
              </div>
              {format.included && (
                <ul>
                  {format.included.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </div>
            <div class="program-format-price">
              <span>Inversión total</span>
              <strong>{format.price}</strong>
              <small>+ IVA</small>
            </div>
          </article>
        ))}
      </div>

      <div class="shell direction-statement">
        <div>
          <span class="eyebrow copper">La lógica del acompañamiento</span>
          <h3>No compras horas.<br /><em>Compras dirección.</em></h3>
        </div>
        <div>
          <p>La intervención no es una mentoría basada en acumular videollamadas. Es un sistema de dirección, revisión y decisión.</p>
          <p>Revisamos bloqueos, desviaciones y siguientes movimientos. La comunicación continúa entre revisiones mediante un canal privado, y las llamadas breves se utilizan únicamente cuando permiten resolver una decisión o evitar que el proceso se detenga.</p>
          <p>El objetivo no es llenar la agenda. Es avanzar con criterio y sin fricción.</p>
        </div>
      </div>

      <div class="shell program-route-cta">
        <div>
          <span class="eyebrow copper">Antes de comprometerte</span>
          <h3>Primero definimos la ruta.</h3>
          <p>El Diagnóstico 1:1 permite ubicar tu punto de partida, identificar el bloqueo principal y determinar qué duración tiene sentido para tu caso. Antes de comenzar recibirás una recomendación clara, con alcance, duración e inversión cerrados.</p>
        </div>
        <a class="button button-primary button-premium" href="/diagnostico">
          Solicitar diagnóstico <span class="button-icon" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="section fit-section">
      <div class="shell fit-grid">
        <div class="fit-card positive">
          <span class="eyebrow copper">Es para ti si</span>
          <h2>Estás preparado para cuestionar lo que sostienes.</h2>
          <ul>
            <li>Ganas bien, pero no te sientes libre.</li>
            <li>Tu vida depende completamente de tu salario.</li>
            <li>No quieres seguir construyendo algo cada vez más pesado.</li>
            <li>Estás dispuesto a tomar decisiones incómodas.</li>
          </ul>
        </div>
        <div class="fit-card muted">
          <span class="eyebrow">No es para ti si</span>
          <h2>Solo quieres añadir más sin cambiar nada.</h2>
          <ul>
            <li>Buscas hacks, validación o motivación.</li>
            <li>Quieres ganar más manteniendo intacta toda tu estructura.</li>
            <li>Esperas que otra persona ejecute por ti.</li>
            <li>No estás preparado para revisar identidad y estatus.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section faq-section light-section">
      <div class="shell faq-grid">
        <div>
          <span class="eyebrow dark">Preguntas frecuentes</span>
          <h2 class="display-dark">Las dudas correctas antes de tomar una decisión importante.</h2>
        </div>
        <div class="faq-list">
          {faqs.map(([question, answer], index) => (
            <details open={index === 0}>
              <summary>{question}<span aria-hidden="true">+</span></summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section final-cta">
      <div class="shell final-cta-inner">
        <span class="eyebrow copper">Antes de que cambiar sea urgente</span>
        <h2>Construye margen para elegir.</h2>
        <p>No necesitas tenerlo todo claro. Necesitas estar dispuesto a mirar tu situación sin autoengaño.</p>
        <WhatsAppButton label="Contarte mi situación" />
      </div>
    </section>

    <Footer />
  </main>
</BaseLayout>
