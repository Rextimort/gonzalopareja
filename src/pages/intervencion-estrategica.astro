---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Deja de depender de un salario — Programa de Intervención 60D">
  <header class="fixed inset-x-0 top-0 z-30 bg-black/70 backdrop-blur">
    <!-- Desktop header -->
    <nav class="mx-auto hidden max-w-6xl grid-cols-3 items-center px-6 py-5 text-sm font-medium tracking-wide text-white/85 md:grid">
      <div class="flex items-center justify-end gap-5 pr-4">
        <a href="/diagnostico" class="hover:text-white">Empieza aquí</a>
        <a href="/login" class="hover:text-white">Login Alumnos</a>
      </div>
      <div class="mx-auto w-full max-w-[260px] text-center">
        <a href="/" class="text-base font-black tracking-widest">GONZALO PAREJA</a>
      </div>
      <div class="flex items-center justify-start pl-4">
        <a
          href="https://wa.me/34690205133?text=Hola%2C%20vengo%20de%20tu%20web%20y%20me%20gustar%C3%ADa%20saber%20si%20puedes%20ayudarme.%20%C2%BFTe%20cuento%20mi%20caso%3F"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-white"
          >Contáctame por WhatsApp (Soy yo)</a
        >
      </div>
    </nav>

    <!-- Mobile header -->
    <nav class="mx-auto flex items-center justify-between px-5 py-4 text-white/90 md:hidden">
      <a href="/" class="font-chivo text-base font-black tracking-widest">GONZALO PAREJA</a>

      <details class="relative">
        <summary class="list-none cursor-pointer select-none">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-lg hover:bg-white/15">☰</span>
        </summary>
        <div class="absolute right-0 mt-3 w-60 rounded-md bg-black/85 p-3 text-sm shadow-2xl ring-1 ring-white/10 backdrop-blur">
          <a class="block rounded px-3 py-2 hover:bg-white/10" href="/diagnostico">Empieza aquí</a>
          <a class="block rounded px-3 py-2 hover:bg-white/10" href="/login">Login Alumnos</a>
          <a
            class="block rounded px-3 py-2 hover:bg-white/10"
            href="https://wa.me/34690205133?text=Hola%2C%20vengo%20de%20tu%20web%20y%20me%20gustar%C3%ADa%20saber%20si%20puedes%20ayudarme.%20%C2%BFTe%20cuento%20mi%20caso%3F"
            target="_blank"
            rel="noopener noreferrer"
            >Contáctame por WhatsApp (Soy yo)</a
          >
        </div>
      </details>
    </nav>
  </header>

  <main class="relative isolate min-h-dvh bg-black text-white">
    <!-- Background (match /diagnostico: black + subtle old-gold aura) -->
    <div class="pointer-events-none absolute inset-0 -z-20 overflow-hidden" aria-hidden="true">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.00),rgba(0,0,0,1))]"></div>
      <div class="absolute -left-56 top-[10vh] h-[560px] w-[560px] rounded-full bg-[radial-gradient(circle,rgba(216,170,90,0.14),rgba(216,170,90,0)_62%)] blur-3xl"></div>
      <div class="absolute -right-56 top-[44vh] h-[560px] w-[560px] rounded-full bg-[radial-gradient(circle,rgba(216,170,90,0.12),rgba(216,170,90,0)_62%)] blur-3xl"></div>
      <div class="absolute bottom-[-300px] left-1/2 h-[660px] w-[660px] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(216,170,90,0.10),rgba(216,170,90,0)_62%)] blur-3xl"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/35 via-black/55 to-black/85"></div>
    </div>

    <div class="relative z-10">

    <!-- Hero: copy impactante + vídeo -->
    <section class="relative">
      <div class="relative z-10 mx-auto flex max-w-5xl flex-col items-center px-6 pb-10 pt-28 text-center">
        <!-- (removed) -->

        <!-- Premium hero card (frozen) -->
        <div class="neon-panel w-full max-w-4xl rounded-3xl bg-white/5 px-8 py-10 text-center ring-1 ring-white/10 backdrop-blur sm:px-12">
          <h1 class="text-balance text-3xl font-extrabold leading-tight tracking-tight text-white/80 sm:text-5xl">
            Si tu vida depende de un sueldo,
            <span class="text-white">estás en riesgo.</span>
            Yo te ayudo a salir de ahí.
          </h1>

          <p class="mt-6 text-pretty text-base text-white/80 sm:text-lg">
            Si has construido una vida que te mantiene atrapado…
            <span class="text-white underline decoration-white/70 decoration-1 underline-offset-4">y que ya no sabes cómo cambiar</span>,
            empieza aquí.
          </p>
        </div>

        <div class="mt-10 w-full max-w-4xl">
          <div class="relative aspect-video overflow-hidden rounded-2xl bg-black ring-1 ring-white/10" style="contain: paint; isolation: isolate; transform: translateZ(0);">
            <!-- Loom embed (temporary). Note: autoplay with sound may be blocked by browsers. -->
            <iframe
              id="metodoFluirVideo"
              class="absolute inset-0 h-full w-full"
              src="https://www.loom.com/embed/4a023603841845c597abf82503b0e363?hide_owner=true&hide_share=true&hide_title=true&hideEmbedTopBar=true"
              frameborder="0"
              allow="fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>

<div class="mt-10 flex w-full flex-col items-center gap-2">
            <a
              href="https://wa.me/34690205133?text=Hola%20Gonzalo.%20He%20visto%20tu%20v%C3%ADdeo%20y%20estoy%20interesad%40%20en%20la%20Intervenci%C3%B3n%2060D.%20%C2%BFTe%20cuento%20mi%20situaci%C3%B3n%3F"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-12 w-full max-w-md items-center justify-center rounded bg-[#f5f0e6] px-8 text-center text-sm font-extrabold leading-tight tracking-tight text-black shadow-[0_18px_45px_rgba(0,0,0,0.55)] hover:bg-white"
            >
              👉 QUIERO DEJAR DE DEPENDER DE UN SALARIO
            </a>
            <p class="text-[12px] font-semibold text-white/75">Abre WhatsApp · Te hago 2 preguntas y me cuentas tu caso</p>
          </div>


          <!-- Loom is an embed, so we can't reliably detect "video ended" to show an overlay.
               Show the closing line right under the video instead. -->
          <div class="mt-6 rounded-md bg-white/5 px-6 py-6 text-center ring-1 ring-white/10 backdrop-blur">
            <p class="text-balance text-lg font-extrabold leading-snug tracking-tight text-white/65 sm:text-2xl">
              Lograr una vida de completa libertad no es cuestión de suerte. Es cuestión de <span class="text-white">estrategia y decisiones</span> sostenidas.
              Si tú quieres conseguirlo, tendrás que empezar a <span class="text-white">decidir distinto</span>.
            </p>
            <p class="mt-4 text-[11px] font-semibold tracking-widest text-white/70 underline decoration-white/60 underline-offset-4">
              La pregunta es si tú estás dispuesto.
            </p>
          </div>

                  </div>

      </div>
    </section>


    <!-- Bloques VSL (moved up): Programa + Qué es/Qué no es + Qué trabajamos -->
    <section class="relative px-6 pt-6 pb-10 sm:pt-10 sm:pb-16">
      <div class="relative z-10 mx-auto max-w-6xl">
        <!-- HERO CARD (premium) -->
        <div class="neon-panel mx-auto max-w-4xl rounded-3xl bg-white/5 p-10 text-center shadow-2xl ring-1 ring-white/10 backdrop-blur sm:p-14">
          <!-- (removed) -->
          <h2 class="mt-6 text-balance text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-6xl">
            Programa de Intervención 60D
          </h2>
          <p class="mt-6 text-pretty text-base text-white/80 sm:text-lg">
            Para dejar de depender de un salario y ganar libertad real.
          </p>
          <div class="mt-10 flex flex-col items-center gap-2">
            <a
              href="https://wa.me/34690205133?text=Hola%20Gonzalo.%20He%20visto%20tu%20v%C3%ADdeo%20y%20estoy%20interesad%40%20en%20la%20Intervenci%C3%B3n%2060D.%20%C2%BFTe%20cuento%20mi%20situaci%C3%B3n%3F"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-12 items-center justify-center rounded bg-[#f5f0e6] px-10 text-center text-sm font-extrabold leading-tight tracking-tight text-black hover:bg-white sm:h-14 sm:px-14 sm:text-base"
            >
              👉 QUIERO DEJAR DE DEPENDER DE UN SALARIO
            </a>
            <p class="text-[12px] font-semibold text-white/75">Abre WhatsApp · Te hago 2 preguntas y me cuentas tu caso</p>
          </div>
        </div>

<!-- Qué te llevas (Intervención 60D) -->
    <section class="relative px-6 pt-10 pb-16 sm:pt-14 sm:pb-20">
      <div class="relative z-10 mx-auto max-w-6xl">
        <div class="mx-auto max-w-4xl text-center">
                    <h2 class="mt-4 text-balance text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-5xl">
            El proceso para recuperar margen, dirección y libertad real
          </h2>
          <p class="mt-5 text-pretty text-base text-white/75 sm:text-lg">
            Para que tu vida no dependa de un salario.
          </p>

        </div>

        <!-- Arms image between subtitle and first cards -->
        <div class="relative z-20 mx-auto mt-1 max-w-5xl">
          <img
            src="/intervencion/arms-lean.jpg"
            alt=""
            aria-hidden="true"
            class="pointer-events-none mx-auto w-full max-w-[920px] -translate-y-1 select-none rounded-3xl brightness-90"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="relative z-10 mx-auto -mt-6 grid max-w-5xl gap-6 sm:-mt-8 sm:grid-cols-2">
          <!-- CARD 1 (premium v1: no mockup) -->
          <div class="rounded-2xl bg-white/5 p-8 shadow-2xl ring-1 ring-white/10 backdrop-blur sm:p-10">
            <div class="flex flex-col items-center justify-center text-center">
              <div class="inline-flex items-center gap-2 text-xs font-semibold tracking-widest text-white/60">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/5 ring-1 ring-white/10">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="rgba(216,170,90,0.95)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
                  </svg>
                </span>
                DECISIONES REALES
              </div>

              <p class="mt-4 text-lg font-extrabold leading-snug tracking-tight text-white sm:text-xl">Diagnóstico 1:1 (90–120 min)</p>

              <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
                <span class="rounded-full bg-white/5 px-3 py-1 text-[11px] font-semibold tracking-widest text-white/70 ring-1 ring-white/10">90–120 MIN</span>
                <span class="rounded-full bg-white/5 px-3 py-1 text-[11px] font-semibold tracking-widest text-white/70 ring-1 ring-white/10">1:1</span>
                <span class="rounded-full bg-white/5 px-3 py-1 text-[11px] font-semibold tracking-widest text-white/70 ring-1 ring-white/10">RADIOGRAFÍA</span>
              </div>
            </div>

            <p class="mt-6 text-sm leading-relaxed text-white/75">
              Analizamos por qué sientes que tu vida no termina de avanzar y qué está haciendo que sigas atrapado en el mismo punto.
              <br /><br />
              Detectamos:
              <br /><span class="text-white/40">•</span> qué te está frenando realmente
              <br /><span class="text-white/40">•</span> por qué sientes que no consigues salir adelante
              <br /><span class="text-white/40">•</span> qué hábitos, decisiones o situaciones te están drenando
              <br /><span class="text-white/40">•</span> y qué tendría que cambiar para que empieces a recuperar control sobre tu vida
              <br /><br />
              No hablamos solo de dinero. Hablamos de dirección, estabilidad y de construir una vida que no dependa de sobrevivir constantemente.
              <br /><br />
              Trabajamos sobre el coste real de seguir manteniendo la misma situación durante los próximos años.
            </p>
            <div class="mt-5 flex items-center justify-center gap-2 text-xs font-semibold tracking-widest text-white/70">
              <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500/20 ring-1 ring-emerald-500/30">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              INCLUIDO
            </div>
          </div>

          <!-- CARD 2 (premium v1: no mockup) -->
          <div class="rounded-2xl bg-white/5 p-8 shadow-2xl ring-1 ring-white/10 backdrop-blur sm:p-10">
            <div class="flex flex-col items-center justify-center text-center">
              <div class="inline-flex items-center gap-2 text-xs font-semibold tracking-widest text-white/60">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/5 ring-1 ring-white/10">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="rgba(216,170,90,0.95)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 6h6v12H3z" />
                    <path d="M9 8h6v10H9z" />
                    <path d="M15 4h6v14h-6z" />
                  </svg>
                </span>
                PLAN + SISTEMA
              </div>

              <p class="mt-4 text-lg font-extrabold leading-snug tracking-tight text-white sm:text-xl">Plan 60D + sistema progresivo</p>

              <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
                <span class="rounded-full bg-white/5 px-3 py-1 text-[11px] font-semibold tracking-widest text-white/70 ring-1 ring-white/10">60 DÍAS</span>
                <span class="rounded-full bg-white/5 px-3 py-1 text-[11px] font-semibold tracking-widest text-white/70 ring-1 ring-white/10">PROGRESIVO</span>
                <span class="rounded-full bg-white/5 px-3 py-1 text-[11px] font-semibold tracking-widest text-white/70 ring-1 ring-white/10">SISTEMA</span>
              </div>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-white/75">
              Creamos un plan claro y realista para que tu vida deje de depender constantemente de llegar al límite.
              <br /><br />
              Definimos:
              <br /><span class="text-white/40">•</span> qué necesitas cambiar primero
              <br /><span class="text-white/40">•</span> cómo aumentar ingresos sin destruirte
              <br /><span class="text-white/40">•</span> qué estructura necesitas construir
              <br /><span class="text-white/40">•</span> y cómo empezar a recuperar estabilidad, control y libertad real
              <br /><br />
              Además, durante el proceso accedes a un sistema progresivo de trabajo dividido por etapas.
              Cada fase está diseñada para ayudarte a:
              <br /><span class="text-white/40">•</span> recuperar capacidad
              <br /><span class="text-white/40">•</span> construir margen
              <br /><span class="text-white/40">•</span> aumentar ingresos
              <br /><span class="text-white/40">•</span> desarrollar habilidades monetizables
              <br /><span class="text-white/40">•</span> y construir una vida con más libertad y menos dependencia
              <br /><br />
              No es solo acompañamiento. Es un proceso estructurado de reconstrucción y ejecución real.
            </p>
            <div class="mt-5 flex items-center justify-center gap-2 text-xs font-semibold tracking-widest text-white/70">
              <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500/20 ring-1 ring-emerald-500/30">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              INCLUIDO
            </div>
          </div>

          <!-- CARD 3 (premium v1: no mockup) -->
          <div class="rounded-2xl bg-white/5 p-8 shadow-2xl ring-1 ring-white/10 backdrop-blur sm:p-10">
            <div class="flex flex-col items-center justify-center text-center">
              <div class="inline-flex items-center gap-2 text-xs font-semibold tracking-widest text-white/60">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/5 ring-1 ring-white/10">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="rgba(216,170,90,0.95)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M8 3v3" />
                    <path d="M16 3v3" />
                    <path d="M4 7h16" />
                    <path d="M6 5h12a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" />
                    <path d="M9.5 13l1.8 1.8L15.5 10.6" />
                  </svg>
                </span>
                REVISIÓN SEMANAL
              </div>

              <p class="mt-4 text-lg font-extrabold leading-snug tracking-tight text-white sm:text-xl">Revisión semanal (60 días)</p>

              <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
                <span class="rounded-full bg-white/5 px-3 py-1 text-[11px] font-semibold tracking-widest text-white/70 ring-1 ring-white/10">SEMANAL</span>
                <span class="rounded-full bg-white/5 px-3 py-1 text-[11px] font-semibold tracking-widest text-white/70 ring-1 ring-white/10">60 DÍAS</span>
                <span class="rounded-full bg-white/5 px-3 py-1 text-[11px] font-semibold tracking-widest text-white/70 ring-1 ring-white/10">CLARIDAD</span>
              </div>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-white/75">
              Cada semana revisamos contigo:
              <br /><span class="text-white/40">•</span> bloqueos
              <br /><span class="text-white/40">•</span> decisiones pendientes
              <br /><span class="text-white/40">•</span> miedos
              <br /><span class="text-white/40">•</span> dudas
              <br /><span class="text-white/40">•</span> y todo lo que esté frenando tu avance
              <br /><br />
              Porque cambiar tu vida no suele depender de entender qué hacer. Suele depender de sostener decisiones distintas el tiempo suficiente como para dejar de volver siempre al mismo punto.
              <br /><br />
              El objetivo es mantener claridad, dirección y movimiento real durante todo el proceso.
            </p>
            <div class="mt-5 flex items-center justify-center gap-2 text-xs font-semibold tracking-widest text-white/70">
              <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500/20 ring-1 ring-emerald-500/30">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              INCLUIDO
            </div>
          </div>

          <!-- CARD 4 (premium v1: no mockup) -->
          <div class="rounded-2xl bg-white/5 p-8 shadow-2xl ring-1 ring-white/10 backdrop-blur sm:p-10">
            <div class="flex flex-col items-center justify-center text-center">
              <div class="inline-flex items-center gap-2 text-xs font-semibold tracking-widest text-white/60">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/5 ring-1 ring-white/10">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="rgba(216,170,90,0.95)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z" />
                    <path d="M7 9h10" />
                    <path d="M7 13h7" />
                  </svg>
                </span>
                CANAL PRIVADO
              </div>

              <p class="mt-4 text-lg font-extrabold leading-snug tracking-tight text-white sm:text-xl">Canal privado + soporte directo</p>

              <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
                <span class="rounded-full bg-white/5 px-3 py-1 text-[11px] font-semibold tracking-widest text-white/70 ring-1 ring-white/10">DIRECTO</span>
                <span class="rounded-full bg-white/5 px-3 py-1 text-[11px] font-semibold tracking-widest text-white/70 ring-1 ring-white/10">SOPORTE</span>
                <span class="rounded-full bg-white/5 px-3 py-1 text-[11px] font-semibold tracking-widest text-white/70 ring-1 ring-white/10">DIRECCIÓN</span>
              </div>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-white/75">
              Contacto directo durante todo el proceso para ayudarte a mantener dirección cuando aparezcan bloqueos, dudas o momentos de presión.
              <br /><br />
              Aquí trabajamos:
              <br /><span class="text-white/40">•</span> decisiones incómodas
              <br /><span class="text-white/40">•</span> situaciones reales
              <br /><span class="text-white/40">•</span> momentos donde sientes que vas a volver atrás
              <br /><span class="text-white/40">•</span> y todo lo que normalmente hace que una persona abandone el cambio que necesita
              <br /><br />
              Porque el problema no suele ser empezar. El problema suele ser sostener una dirección distinta cuando tu entorno, tus hábitos o tu miedo intentan llevarte otra vez al mismo lugar.
            </p>
            <div class="mt-5 flex items-center justify-center gap-2 text-xs font-semibold tracking-widest text-white/70">
              <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-emerald-500/20 ring-1 ring-emerald-500/30">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#34d399" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              INCLUIDO
            </div>
          </div>

          <!-- CARD 5 (premium v1: no mockup) -->
          <div class="rounded-2xl bg-white/5 p-8 shadow-2xl ring-1 ring-white/10 backdrop-blur sm:p-10">
            <div class="flex flex-col items-center justify-center text-center">
              <div class="inline-flex items-center gap-2 text-xs font-semibold tracking-widest text-white/60">
