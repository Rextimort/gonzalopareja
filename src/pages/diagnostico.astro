---
import BaseLayout from '../layouts/BaseLayout.astro';

const PAGE_TITLE = 'Diagnóstico — Gonzalo Pareja';
---

<BaseLayout title={PAGE_TITLE}>
  <header class="fixed inset-x-0 top-0 z-30 bg-black/70 backdrop-blur">
    <!-- Desktop header -->
    <nav class="mx-auto hidden max-w-6xl grid-cols-3 items-center px-6 py-5 text-sm font-medium tracking-wide text-white/85 md:grid">
      <div class="flex items-center justify-end gap-5 pr-4">
        <a href="/diagnostico" class="hover:text-white">Empieza aquí</a>
        <a href="/login" class="hover:text-white">Login Alumnos</a>
      </div>
      <div class="mx-auto w-full max-w-[260px] text-center">
        <a href="/" class="text-base font-black tracking-widest">GONZALO PAREJA</a>
      </div>
      <div class="flex items-center justify-start pl-4">
        <a
          href="https://wa.me/34690205133?text=Hola%2C%20vengo%20de%20tu%20web%20y%20me%20gustar%C3%ADa%20saber%20si%20puedes%20ayudarme.%20%C2%BFTe%20cuento%20mi%20caso%3F"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-white"
          >Contáctame por WhatsApp (Soy yo)</a
        >
      </div>
    </nav>

    <!-- Mobile header -->
    <nav class="mx-auto flex items-center justify-between bg-black/70 px-5 py-4 text-white/90 backdrop-blur md:hidden">
      <a href="/" class="font-chivo text-base font-black tracking-widest">GONZALO PAREJA</a>

      <details class="relative">
        <summary class="list-none cursor-pointer select-none">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-lg hover:bg-white/15">☰</span>
        </summary>
        <div class="absolute right-0 mt-3 w-60 rounded-md bg-black/85 p-3 text-sm shadow-2xl ring-1 ring-white/10 backdrop-blur">
          <a class="block rounded px-3 py-2 hover:bg-white/10" href="/diagnostico">Empieza aquí</a>
          <a class="block rounded px-3 py-2 hover:bg-white/10" href="/login">Login Alumnos</a>
          <a
            class="block rounded px-3 py-2 hover:bg-white/10"
            href="https://wa.me/34690205133?text=Hola%2C%20vengo%20de%20tu%20web%20y%20me%20gustar%C3%ADa%20saber%20si%20puedes%20ayudarme.%20%C2%BFTe%20cuento%20mi%20caso%3F"
            target="_blank"
            rel="noopener noreferrer"
            >Contáctame por WhatsApp (Soy yo)</a
          >
        </div>
      </details>
    </nav>
  </header>

  <main class="relative isolate min-h-dvh bg-black text-white">
    <!-- Premium background (subtle) -->
    <div class="pointer-events-none absolute inset-0 -z-20 overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.06),rgba(0,0,0,0.90))]"></div>

      <!-- Background only (no glow) -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/35 via-black/55 to-black/85"></div>
    </div>

    <!-- HERO (with image) -->
    <section class="relative z-0 mx-auto flex min-h-[92vh] max-w-6xl flex-col items-center justify-center px-6 pt-32 pb-20 text-center sm:pt-28">
      <div class="pointer-events-none absolute inset-0 -z-10">
        <img
          src="/diagnostico/hero.jpg"
          alt=""
          aria-hidden="true"
          class="h-full w-full object-cover opacity-100"
          loading="eager"
          decoding="async"
          style="object-position: 28% 35%; filter: grayscale(0.16) contrast(1.12) brightness(0.98) saturate(0.92);"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/32 via-black/42 to-black/90"></div>
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0.10),rgba(0,0,0,0.78))]"></div>
      </div>

      <div class="relative z-10 max-w-4xl">
        <h1 class="text-balance text-4xl font-extrabold leading-[1.05] tracking-tight text-white sm:text-6xl">
          Tu vida puede no estar mal…
          Y aun así sentirte atrapado.
        </h1>
        <p class="mx-auto mt-7 max-w-3xl text-pretty text-base text-white/75 sm:text-lg">
          Hay personas inteligentes que pasan años sintiendo que no avanzan. No porque no tengan capacidad.
          Sino porque han construido una vida que ya no saben cómo cambiar.
        </p>

        <div class="mt-10 flex w-full justify-center">
          <button
            id="startBtn"
            class="inline-flex h-12 items-center justify-center rounded bg-[#f5f0e6] px-8 text-sm font-extrabold tracking-tight text-black shadow-[0_18px_45px_rgba(0,0,0,0.5)] hover:bg-white sm:h-14 sm:px-10 sm:text-base"
            type="button"
          >
            Entender qué me está pasando
          </button>
        </div>

        <div class="mt-10 flex w-full justify-center">
          <div class="relative flex h-16 w-10 items-start justify-center">
            <div class="mt-1 h-14 w-px bg-white/30"></div>
            <svg
              class="absolute bottom-0"
              width="16"
              height="10"
              viewBox="0 0 16 10"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path d="M1 1.5L8 8.5L15 1.5" stroke="rgba(255,255,255,0.50)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- OBJETIVO PSICOLÓGICO (micro) -->
    <section class="relative mx-auto max-w-5xl px-6 pb-6">
      <div class="mx-auto rounded-3xl bg-white/5 px-8 py-8 ring-1 ring-white/10 backdrop-blur neon-panel">
        <p class="text-xs font-semibold tracking-widest text-white/70">
          SI ESTÁS AQUÍ, ES PORQUE TODAVÍA CREES QUE ESTO PUEDE CAMBIAR.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-white/70">
          Esta no es una landing de venta. Es un diagnóstico para que te veas reflejado, entiendas por qué te sientes así…
          y veas que existe una salida estructurada.
        </p>
      </div>
    </section>

    <!-- SECCIÓN 1 — DIAGNÓSTICO EMOCIONAL -->
    <section id="sec1" class="relative mx-auto max-w-5xl px-6 pt-14 pb-6">
      <div class="mx-auto text-center">
        <p class="inline-flex items-center gap-2 rounded-full bg-white/5 px-4 py-2 text-[11px] font-semibold tracking-widest text-white/70 ring-1 ring-white/10">
          SECCIÓN 1 · DIAGNÓSTICO EMOCIONAL
        </p>
      </div>

      <div class="mt-10 space-y-8">
        <div class="focus-block rounded-3xl bg-white/5 px-8 py-10 ring-1 ring-white/10 backdrop-blur neon-soft">
          <h2 class="text-balance text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">
            No estás cansado solo de trabajar.
            <span class="text-white/80">Estás cansado de esforzarte para sostener una vida que se mantiene siempre igual.</span>
          </h2>
        </div>

        <div class="focus-block rounded-3xl bg-white/5 px-8 py-10 ring-1 ring-white/10 backdrop-blur neon-soft">
          <h2 class="text-balance text-2xl font-extrabold leading-snug tracking-tight sm:text-3xl text-center">
            El problema no siempre es visible desde fuera.
          </h2>
          <p class="mx-auto mt-5 max-w-3xl text-center text-base leading-relaxed text-white/75">
            Muchas personas:
            <br />— trabajan
            <br />— cumplen
            <br />— funcionan
            <br />— incluso parecen estables…
            <br /><br />
            pero sienten que no pueden parar, ni cambiar cosas o tomar decisiones importantes sin miedo a equivocarse o a que todo se les venga abajo.
          </p>
        </div>

        <div class="focus-block rounded-3xl bg-white/5 px-8 py-10 text-center ring-1 ring-white/10 backdrop-blur neon-soft">
          <h2 class="text-balance text-2xl font-extrabold leading-snug tracking-tight sm:text-3xl">
            A veces el agotamiento no viene del trabajo.
          </h2>
          <p class="mt-5 text-base leading-relaxed text-white/75">
            Viene de sostener durante años una vida que ya no encaja contigo.
          </p>
        </div>

        <div class="focus-block rounded-3xl bg-white/5 px-8 py-10 text-center ring-1 ring-white/10 backdrop-blur neon-soft">
          <h2 class="text-balance text-2xl font-extrabold leading-snug tracking-tight sm:text-3xl">
            Y cuanto más tiempo pasa…
            <span class="text-white/80">más difícil parece salir.</span>
          </h2>
        </div>
      </div>

      <div class="mx-auto mt-14 flex max-w-3xl items-center gap-6">
        <div class="h-16 w-px bg-[linear-gradient(to_bottom,rgba(245,210,120,0),rgba(245,210,120,0.75),rgba(245,210,120,0))]"></div>
        <p class="text-sm font-semibold text-white/70">
          Pero no todas las personas atrapadas están atrapadas por lo mismo.
        </p>
      </div>
    </section>

    <!-- BLOQUE TIPO ABEL (movido a Sección 4) -->

    <!-- SECCIÓN 2 — DOS FORMAS DE ESTAR ATRAPADO -->
    <section id="sec2" class="relative mx-auto max-w-6xl px-6 pt-16 pb-8">
      <div class="mx-auto text-center">
        <p class="inline-flex items-center gap-2 rounded-full bg-white/5 px-4 py-2 text-[11px] font-semibold tracking-widest text-white/70 ring-1 ring-white/10">
          SECCIÓN 2 · DOS FORMAS DE ESTAR ATRAPADO
        </p>
      </div>

      <div class="mt-10 grid gap-8 md:grid-cols-2">
        <!-- NIVEL 1 -->
        <div class="focus-block rounded-3xl bg-white/5 px-8 py-10 ring-1 ring-white/10 backdrop-blur neon-panel">
          <p class="text-xs font-semibold tracking-widest text-white/70 text-center">NIVEL 1</p>
          <h3 class="mt-4 text-balance text-3xl font-extrabold leading-tight tracking-tight text-center">
            “Siento que mi vida no arranca.”
          </h3>
          <p class="mt-6 text-base leading-relaxed text-white/75">
            Hay personas que viven constantemente al límite. Ganan poco. No tienen margen ni tampoco ahorros.
            No saben qué habilidad aprender. No creen realmente que puedan cambiar su vida rápido.
            Y después de años sobreviviendo… empiezan a pensar que quizá esa será siempre su realidad.
            <br /><br />
            Pero el problema no es solo cuánto ganas. También es:
            <br />— la falta de dirección
            <br />— las creencias que te hacen pensar que no puedes salir
            <br />— las habilidades que todavía no has desarrollado
            <br />— y la estructura de vida que actualmente sostienes
            <br /><br />
            Porque muchas personas intentan ganar más… sin cambiar nada a su alrededor.
            Y por eso vuelven siempre al mismo punto.
          </p>

          <div class="mt-8 rounded-2xl bg-black/30 px-6 py-6 text-center ring-1 ring-white/10">
            <p class="text-sm font-extrabold text-white">
              “No necesitas motivación. Necesitas una dirección clara que le de sentido a tu esfuerzo, una estrategia que puedas seguir, y aprender a construir una estructura de vida que te permita crecer y sostener los resultados.”
            </p>
          </div>
        </div>

        <!-- NIVEL 2 -->
        <div class="focus-block rounded-3xl bg-white/5 px-8 py-10 ring-1 ring-white/10 backdrop-blur neon-panel">
          <p class="text-xs font-semibold tracking-widest text-white/70 text-center">NIVEL 2</p>
          <h3 class="mt-4 text-balance text-3xl font-extrabold leading-tight tracking-tight text-center">
            “En teoría me va bien… pero sigo sintiéndome atrapado.”
          </h3>
          <p class="mt-6 text-base leading-relaxed text-white/75">
            Hay personas que ya tienen estudios, experiencia, salario estable y una vida aparentemente correcta.
            Pero aun así sienten agotamiento, estancamiento, dependencia y miedo a seguir dependiendo de un salario para poder mantener lo que han construido.
            <br /><br />
            Saben trabajar. Pero no saben:
            <br />— venderse
            <br />— reposicionarse
            <br />— negociar su valor
            <br />— construir libertad real
            <br />— ni salir de la estructura que llevan años sosteniendo.
            <br /><br />
            Y cuanto más crece su estructura de vida… más difícil parece hacer cambios en su vida.
          </p>

          <div class="mt-8 rounded-2xl bg-black/30 px-6 py-6 text-center ring-1 ring-white/10">
            <p class="text-sm font-extrabold text-white">
              “El problema en tu caso ya no es solo el dinero. Es la vida que has construido alrededor del personaje que llevas sosteniendo durante años.”
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 3 — PUNTO DE CONVERGENCIA -->
    <section class="relative mx-auto max-w-6xl px-6 pt-16 pb-8">
      <div class="mx-auto text-center">
        <p class="inline-flex items-center gap-2 rounded-full bg-white/5 px-4 py-2 text-[11px] font-semibold tracking-widest text-white/70 ring-1 ring-white/10">
          SECCIÓN 3 · PUNTO DE CONVERGENCIA
        </p>
      </div>

      <div class="mt-10 rounded-3xl bg-white/5 px-8 pt-9 pb-6 sm:pb-9 text-center ring-1 ring-white/10 backdrop-blur">
        <h3 class="text-balance text-3xl font-extrabold leading-tight tracking-tight sm:text-5xl">
          Aunque sus vidas parezcan distintas… el problema termina siendo el mismo.
        </h3>
        <p class="mx-auto mt-6 max-w-3xl text-pretty text-base text-white/75 sm:text-lg">
          Dependencia. Falta de dirección. Poca capacidad de decisión.
          Y una vida demasiado frágil ante el cambio.
        </p>
      </div>

      <!-- Señalador 16:9 (mobile con más aire; desktop pegado) -->
      <div class="mx-auto mt-0 max-w-6xl sm:-mt-2">
        <div class="pointing-soft relative overflow-hidden rounded-3xl bg-black/40 ring-1 ring-white/10">
          <picture>
            <source media="(max-width: 639px)" srcset="/diagnostico/pointing-16x9-mobile.png" />
            <img
              src="/diagnostico/pointing-16x9.png"
              alt=""
              aria-hidden="true"
              class="h-auto w-full"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <!-- soften poster vibe -->
          <div class="pointer-events-none absolute inset-0 bg-black/15"></div>
        </div>
      </div>

      <!-- (Bloque eliminado por petición) -->

    </section>

    <!-- SECCIÓN 4 — EXISTE UNA SALIDA -->
    <section class="relative mx-auto max-w-6xl px-6 pt-16 pb-10">
      <div class="mx-auto text-center">
        <p class="inline-flex items-center gap-2 rounded-full bg-white/5 px-4 py-2 text-[11px] font-semibold tracking-widest text-white/70 ring-1 ring-white/10">
          SECCIÓN 4 · EXISTE UNA SALIDA
        </p>
      </div>

      <div class="mt-10 rounded-3xl bg-white/5 px-8 py-12 text-center ring-1 ring-white/10 backdrop-blur">
        <h3 class="text-balance text-3xl font-extrabold leading-tight tracking-tight sm:text-5xl">
          Por eso creé este programa.
        </h3>

        <!-- BLOQUE TIPO ABEL (puente identidad → cambio) -->
        <div class="mx-auto mt-10 w-full max-w-6xl">
          <div class="grid items-start gap-8 md:grid-cols-[1fr_360px_1fr]">
            <!-- Left -->
            <div class="space-y-4 text-left">
              <h4 class="text-balance text-2xl font-extrabold tracking-tight sm:text-3xl text-center">Para personas que:</h4>

              <div class="rounded-2xl bg-white/5 px-6 py-5 ring-1 ring-white/10 backdrop-blur neon-soft">
                <p class="text-sm font-semibold text-white/90">Se han cuestionado su vida más de una vez.</p>
                <p class="mt-2 text-sm text-white/65">No porque “todo vaya mal”. Sino porque por dentro hay un malestar constante.</p>
              </div>
              <div class="rounded-2xl bg-white/5 px-6 py-5 ring-1 ring-white/10 backdrop-blur neon-soft">
                <p class="text-sm font-semibold text-white/90">Sienten que sostienen una vida que ya no encaja.</p>
                <p class="mt-2 text-sm text-white/65">Cumplen. Funcionan. Pero no pueden parar ni moverse sin miedo a joder algo.</p>
              </div>
              <div class="rounded-2xl bg-white/5 px-6 py-5 ring-1 ring-white/10 backdrop-blur neon-soft">
                <p class="text-sm font-semibold text-white/90">Quieren dirección real.</p>
                <p class="mt-2 text-sm text-white/65">No más consejos de gurú barato que les prometa cambiar su vida en 30 días, sino un mapa claro de decisiones que les lleve en una dirección que puedan seguir en su día a día.</p>
              </div>
            </div>

            <!-- Center (image card) -->
            <div class="mx-auto w-full">
              <div class="rounded-[28px] bg-white/5 p-3 ring-1 ring-white/10 backdrop-blur neon-panel">
                <div class="overflow-hidden rounded-[22px] bg-black">
                  <img
                    src="/diagnostico/abel-block.png"
                    alt=""
                    aria-hidden="true"
                    class="h-[520px] w-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="px-5 pt-5 pb-4 text-center">
                  <p class="text-sm text-white/70">Si buscas fórmulas rápidas, este no es el lugar.</p>
                  <p class="mt-2 text-sm font-semibold text-white/85">Si buscas reconstrucción real, sí.</p>
                  <div class="mt-4 flex justify-center">
                    <a
                      href="/intervencion-estrategica"
                      class="inline-flex h-11 items-center justify-center rounded bg-[#f5f0e6] px-6 text-sm font-extrabold tracking-tight text-black hover:bg-white"
                      >Ver el programa de intervención</a
                    >
                  </div>
                </div>
              </div>
            </div>

            <!-- Right -->
            <div class="space-y-4 text-left">
              <h4 class="text-balance text-2xl font-extrabold tracking-tight sm:text-3xl text-center">Lo que empieza a cambiar</h4>

              <div class="rounded-2xl bg-white/5 px-6 py-5 ring-1 ring-white/10 backdrop-blur neon-soft">
                <p class="text-sm font-semibold text-white/90">Dejas de vivir reaccionando.</p>
                <p class="mt-2 text-sm text-white/65">Se corta la inercia. Empiezas a elegir.</p>
              </div>
              <div class="rounded-2xl bg-white/5 px-6 py-5 ring-1 ring-white/10 backdrop-blur neon-soft">
                <p class="text-sm font-semibold text-white/90">Recuperas margen.</p>
                <p class="mt-2 text-sm text-white/65">No “más paz mental”. Capacidad real de movimiento.</p>
              </div>
              <div class="rounded-2xl bg-white/5 px-6 py-5 ring-1 ring-white/10 backdrop-blur neon-soft">
                <p class="text-sm font-semibold text-white/90">La acción deja de ser forzada.</p>
                <p class="mt-2 text-sm text-white/65">Cuando la estructura cambia, decidir deja de doler tanto.</p>
              </div>
              <div class="rounded-2xl bg-white/5 px-6 py-5 ring-1 ring-white/10 backdrop-blur neon-soft">
                <p class="text-sm font-semibold text-white/90">Dejas de negociar contigo mismo.</p>
                <p class="mt-2 text-sm text-white/65">Empiezas a hacer lo que sabes que tienes que hacer, sin drama.</p>
              </div>
            </div>
          </div>
        </div>

        <p class="mx-auto mt-14 max-w-3xl text-pretty text-base text-white/75 sm:text-lg">
          No como una mentoría motivacional. Ni como un curso financiero.
          Sino como un proceso estructurado para ayudarte a recuperar dirección, aumentar capacidad,
          construir margen, reducir dependencia… y empezar a construir una vida con libertad real.
        </p>

        <div class="mx-auto mt-10 grid max-w-5xl gap-6 sm:grid-cols-2 lg:flex lg:items-stretch lg:gap-3">
          <div class="flex-1 rounded-3xl bg-black/35 p-6 ring-1 ring-white/10">
            <p class="text-xs font-semibold tracking-widest text-white/70">ETAPA 1</p>
            <p class="mt-4 text-sm font-extrabold">Recuperar capacidad</p>
            <p class="mt-3 text-sm text-white/70">Más ingresos. Más claridad. Más dirección.</p>
          </div>

          <!-- Arrow -->
          <div class="hidden lg:flex items-center justify-center px-1">
            <svg width="44" height="12" viewBox="0 0 44 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M0 6H38" stroke="rgba(216,170,90,0.55)" stroke-width="1" stroke-linecap="round"/>
              <path d="M38 1L43 6L38 11" stroke="rgba(216,170,90,0.55)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

          <div class="flex-1 rounded-3xl bg-black/35 p-6 ring-1 ring-white/10">
            <p class="text-xs font-semibold tracking-widest text-white/70">ETAPA 2</p>
            <p class="mt-4 text-sm font-extrabold">Construir margen</p>
            <p class="mt-3 text-sm text-white/70">Reducir dependencia. Recuperar movimiento.</p>
          </div>

          <!-- Arrow -->
          <div class="hidden lg:flex items-center justify-center px-1">
            <svg width="44" height="12" viewBox="0 0 44 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M0 6H38" stroke="rgba(216,170,90,0.55)" stroke-width="1" stroke-linecap="round"/>
              <path d="M38 1L43 6L38 11" stroke="rgba(216,170,90,0.55)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

          <div class="flex-1 rounded-3xl bg-black/35 p-6 ring-1 ring-white/10">
            <p class="text-xs font-semibold tracking-widest text-white/70">ETAPA 3</p>
            <p class="mt-4 text-sm font-extrabold">Diseñar una vida más libre</p>
            <p class="mt-3 text-sm text-white/70">Trabajo compatible con libertad. Estructura flexible.</p>
          </div>

          <!-- Arrow -->
          <div class="hidden lg:flex items-center justify-center px-1">
            <svg width="44" height="12" viewBox="0 0 44 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M0 6H38" stroke="rgba(216,170,90,0.55)" stroke-width="1" stroke-linecap="round"/>
              <path d="M38 1L43 6L38 11" stroke="rgba(216,170,90,0.55)" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

          <div class="flex-1 rounded-3xl bg-black/35 p-6 ring-1 ring-white/10">
            <p class="text-xs font-semibold tracking-widest text-white/70">ETAPA 4</p>
            <p class="mt-4 text-sm font-extrabold">Patrimonio y libertad real</p>
            <p class="mt-3 text-sm text-white/70">Inversión. Cashflow. Libertad estructural.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 5 — TRANSICIÓN HACIA VSL -->
    <section id="sec5" class="relative mx-auto max-w-6xl px-6 pt-14 pb-24">
      <div class="mx-auto rounded-3xl bg-white/5 px-8 py-14 text-center ring-1 ring-white/10 backdrop-blur neon-panel">
