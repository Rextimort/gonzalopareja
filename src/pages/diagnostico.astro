    <script is:inline>
      // Scroll to first section (no aggressive scroll-jacking)
      const btn = document.getElementById('startBtn');
      btn?.addEventListener('click', () => {
        document.getElementById('sec1')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      // Soft focus effect on scroll: highlight the block near the middle.
      const blocks = Array.from(document.querySelectorAll('.focus-block'));
      const obs = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) e.target.classList.add('is-active');
            else e.target.classList.remove('is-active');
          }
        },
        { root: null, rootMargin: '-35% 0px -35% 0px', threshold: 0.01 }
      );
      blocks.forEach((b) => obs.observe(b));
    </script>

    <style>
      /* GoldSoft (oro viejo) */
      .neon-panel {
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.10),
          0 0 26px rgba(216, 170, 90, 0.22),
          0 0 72px rgba(216, 170, 90, 0.14);
      }
      .neon-soft {
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.08),
          0 0 16px rgba(216, 170, 90, 0.16),
          0 0 46px rgba(216, 170, 90, 0.10);
      }

      /* Option A: soften the 'poster vibe' image in-web (reversible) */
      .pointing-soft img {
        filter: contrast(0.92) saturate(0.88) brightness(1.04);
      }

      .focus-block {
        opacity: 0.78;
        transform: translateY(6px) scale(0.995);
        transition: opacity 700ms cubic-bezier(0.16, 1, 0.3, 1), transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
      }
      .focus-block.is-active {
        opacity: 1;
        transform: translateY(0px) scale(1);
      }
      @media (prefers-reduced-motion: reduce) {
        .focus-block,
        .focus-block.is-active {
          transition: none;
          transform: none;
        }
      }
    </style>
