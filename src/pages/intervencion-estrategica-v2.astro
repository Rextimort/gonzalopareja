---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Deja de depender de un salario — Programa de Intervención 60D">
  <main class="relative isolate min-h-dvh bg-black text-white">
    <!-- Background (match /diagnostico: black + subtle old-gold aura) -->
    <div class="pointer-events-none absolute inset-0 -z-20 overflow-hidden" aria-hidden="true">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.06),rgba(0,0,0,0.90))]"></div>
      <div class="absolute -left-56 top-[10vh] h-[560px] w-[560px] rounded-full bg-[radial-gradient(circle,rgba(216,170,90,0.14),rgba(216,170,90,0)_62%)] blur-3xl"></div>
      <div class="absolute -right-56 top-[44vh] h-[560px] w-[560px] rounded-full bg-[radial-gradient(circle,rgba(216,170,90,0.12),rgba(216,170,90,0)_62%)] blur-3xl"></div>
      <div class="absolute bottom-[-300px] left-1/2 h-[660px] w-[660px] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(216,170,90,0.10),rgba(216,170,90,0)_62%)] blur-3xl"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-black/35 via-black/55 to-black/85"></div>
    </div>

    <!-- NOTE: v2 mockup route for styling; copies largely kept. -->

    <!-- Hero: copy + video -->
    <section class="relative">
      <div class="mx-auto flex max-w-5xl flex-col items-center px-6 pb-10 pt-16 text-center">
        <p class="text-xs font-semibold tracking-widest text-white/60">GONZALO PAREJA (Dirección Real para una Vida Libre)</p>

        <h1 class="mt-3 max-w-4xl text-balance text-3xl font-extrabold leading-tight tracking-tight sm:text-5xl">
          Si tu vida depende de un sueldo,
          <span class="text-white">estás en riesgo.</span>
          Yo te ayudo a salir de ahí.
        </h1>

        <p class="mt-6 max-w-3xl text-pretty text-base text-white/80 sm:text-lg">
          Si sabes que tu vida podría ser muy distinta…
          <span class="underline decoration-white/70 decoration-1 underline-offset-4">pero no puedes cambiarla sin que todo se rompa</span>,
          empieza aquí.
        </p>

        <div class="mt-10 w-full max-w-4xl">
          <div class="mx-auto mb-6 flex w-full max-w-xl items-center justify-center">
            <img
              src="/proof-50-clientes.png"
              alt="50+ clientes"
              class="h-7 w-auto select-none sm:h-11"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="relative aspect-video overflow-hidden rounded-2xl bg-black ring-1 ring-white/10" style="contain: paint; isolation: isolate; transform: translateZ(0);">
            <iframe
              id="metodoFluirVideo"
              class="absolute inset-0 h-full w-full"
              src="https://www.loom.com/embed/4a023603841845c597abf82503b0e363?hide_owner=true&hide_share=true&hide_title=true&hideEmbedTopBar=true"
              frameborder="0"
              allow="fullscreen; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>

          <div class="mt-10 flex w-full flex-col items-center gap-2">
            <a
              href="/checkout"
              class="inline-flex h-12 w-full max-w-md items-center justify-center rounded bg-[#f5f0e6] px-8 text-center text-sm font-extrabold leading-tight tracking-tight text-black shadow-[0_18px_45px_rgba(0,0,0,0.55)] hover:bg-white"
            >
              Solicitar diagnóstico 1:1
            </a>
            <p class="text-[12px] font-semibold text-white/75">Diagnóstico 1:1 · 60€ (pago único)</p>
          </div>

          <div class="mt-6 rounded-2xl bg-white/5 px-6 py-6 text-center ring-1 ring-white/10 backdrop-blur">
            <p class="text-balance text-lg font-extrabold leading-snug tracking-tight text-white sm:text-2xl">
              Lograr una vida de completa libertad no es cuestión de suerte. Es cuestión de
              <span style="color: oklch(0.86 0.2 86.23)">estrategia y decisiones</span>
              sostenidas.
              Si tú quieres conseguirlo, tendrás que empezar a decidir distinto.
            </p>
            <p class="mt-4 text-[11px] font-semibold tracking-widest text-white/70 underline decoration-white/50 underline-offset-4">
              La pregunta es si tú estás dispuesto.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Blocks (kept for now; style pass only) -->
    <section class="relative px-6 pt-6 pb-10 sm:pt-10 sm:pb-16">
      <div class="mx-auto max-w-6xl">
        <div class="mx-auto max-w-4xl rounded-3xl bg-white/5 p-10 text-center ring-1 ring-white/10 backdrop-blur sm:p-14">
          <p class="text-xs font-semibold tracking-widest text-white/70">GONZALO PAREJA (Dirección Real para una Vida Libre)</p>
          <h2 class="mt-6 text-balance text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-6xl">Programa de Intervención 60D</h2>
          <p class="mt-6 text-pretty text-base text-white/80 sm:text-lg">Para dejar de depender de un salario y ganar libertad real.</p>
          <div class="mt-10 flex flex-col items-center gap-2">
            <a
              href="/checkout"
              class="inline-flex h-12 items-center justify-center rounded bg-[#f5f0e6] px-10 text-center text-sm font-extrabold leading-tight tracking-tight text-black hover:bg-white sm:h-14 sm:px-14 sm:text-base"
            >
              Solicitar diagnóstico 1:1
            </a>
            <p class="text-[12px] font-semibold text-white/75">Diagnóstico 1:1 · 60€ (pago único)</p>
          </div>
        </div>

        <!-- Keep the rest of the page content for now (existing copy/sections) -->
        <div class="mt-10 rounded-3xl bg-white/5 p-6 ring-1 ring-white/10 backdrop-blur">
          <p class="text-sm text-white/70">
            Mockup v2: fondo + estética premium alineada a /diagnostico. Próximo paso: adaptar secciones/cards de abajo con el mismo sistema de
            cajas (ring/blur), tipografía y CTAs.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
