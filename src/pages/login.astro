---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import LoginForm from "../components/LoginForm.astro";
---

<BaseLayout
  title="Área privada"
  description="Acceso reservado a clientes del Programa mediante enlace seguro enviado por email."
>
  <main class="login-page">
    <Header active="login" overlay />
    <div class="login-photo" aria-hidden="true"></div>
    <div class="login-shade" aria-hidden="true"></div>
    <div class="login-lines" aria-hidden="true"><i></i><i></i><i></i></div>

    <div class="shell login-layout">
      <div class="login-story">
        <span class="eyebrow">Área privada</span>
        <p>Pasar de sostener tu vida<br />a poder dirigirla.</p>
        <small>Gonzalo Pareja · Capacidad, margen y dirección</small>
      </div>

      <section class="login-panel" aria-labelledby="login-title">
        <div class="login-panel-index"><span>ACCESO SEGURO</span><b>01</b></div>
        <h1 id="login-title">Bienvenido<br /><em>de vuelta.</em></h1>
        <p class="login-intro">Introduce el email con el que adquiriste tu acceso y te enviaré un enlace para entrar.</p>
        <LoginForm />
        <div class="login-support">
          <span>¿Necesitas ayuda?</span>
          <a href="https://wa.me/34690205133?text=Hola%20Gonzalo.%20Necesito%20ayuda%20para%20acceder%20al%20%C3%A1rea%20privada." target="_blank" rel="noreferrer">
            Pedir ayuda por WhatsApp <b aria-hidden="true">↗</b>
          </a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
